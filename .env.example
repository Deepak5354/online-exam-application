# Copy this file to .env for local development. Never commit .env.
#
# Everything is optional in development: with nothing set, the API starts an
# in-memory MongoDB (data resets on restart), seeds the starter question bank
# and uses a built-in dev secret.

# MongoDB connection string. Required in production.
#   Local MongoDB:  mongodb://127.0.0.1:27017/test-desk
#   MongoDB Atlas:  mongodb+srv://USER:PASSWORD@cluster.mongodb.net/test-desk
# MONGODB_URI=mongodb://127.0.0.1:27017/test-desk

# Signs the login session cookie. Required in production. Generate one with:
#   openssl rand -base64 32
# JWT_SECRET=replace-with-a-long-random-string

# Public URL of the app (used in password reset links). Default: http://localhost:3000
# APP_URL=https://your-app.onrender.com

# API port. Default: 4000
# PORT=4000

# ── Online test settings ─────────────────────────────────────────────
# Questions in every test. Default: 10
# QUESTIONS_PER_TEST=10
# Countdown length in seconds. Default: 600 (10 minutes)
# TEST_DURATION_SECONDS=600
# Percentage needed to pass. Default: 40
# TEST_PASS_PERCENT=40
# Emails that become admins when they sign up (comma separated).
# Existing accounts can be promoted with: npm run make-admin -- you@example.com
# ADMIN_EMAILS=admin@example.com

# ── Password reset email (optional) ──────────────────────────────────
# Send real reset emails through Resend (needs a verified domain to email
# anyone other than yourself). Without these, the link is printed in the server
# console during development.
# RESEND_API_KEY=
# RESET_EMAIL_FROM="Test Desk <no-reply@your-domain.com>"

# DEMO SITES ONLY: show the password reset link on screen instead of emailing it,
# so a reviewer can try "Forgot password" without an inbox. Anyone who knows an
# email could then reset that account, so never enable this for real users.
# DEMO_SHOW_RESET_LINK=true
